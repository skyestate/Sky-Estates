# ─── URL publique du site (sans slash final) ───────────────────────────────
# À REMPLIR : remplace par ton vrai nom de domaine une fois acheté.
NEXT_PUBLIC_SITE_URL=https://www.skyestates.es

# ─── Envoi des demandes de devis (Resend) ──────────────────────────────────
# 1. Crée un compte gratuit sur https://resend.com
# 2. Vérifie ton domaine (ou utilise onboarding@resend.dev pour tester)
# 3. Copie ta clé API ici, et ajoute-la aussi dans Vercel > Settings > Environment Variables
#
# Si RESEND_API_KEY est absente, le formulaire bascule automatiquement
# sur un repli WhatsApp / e-mail : le site ne casse jamais.
RESEND_API_KEY=
CONTACT_FROM="Sky Estates <devis@skyestates.es>"
CONTACT_TO=skyestates0@gmail.com
